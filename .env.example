# ===== AI =====
# คีย์ Claude API (สมัครที่ console.anthropic.com)
ANTHROPIC_API_KEY=
# รุ่นโมเดล (ไม่ใส่ก็ได้)
ANTHROPIC_MODEL=claude-sonnet-5-5
# ตั้งเป็น 1 เพื่อทดลองโดยไม่เรียก AI จริง (ใช้ข้อมูลตัวอย่าง)
MOCK_AI=1

# ===== การชำระเงิน =====
# mock  = จำลอง ไม่เก็บเงินจริง (มีปุ่ม "จำลองว่าจ่ายแล้ว")
# omise = ใช้ Omise PromptPay จริง
PAYMENT_MODE=mock
# Secret key จาก Omise Dashboard
# skey_test_... = โหมดทดสอบ (ยังมีปุ่มจำลองว่าจ่ายแล้ว) / skey_... = เก็บเงินจริง
OMISE_SECRET_KEY=
# ราคา (บาท) ขั้นต่ำของ PromptPay คือ 20 บาท
NEXT_PUBLIC_PRICE_THB=79

# ===== ที่เก็บข้อมูล (ต้องมีตอนขึ้นเว็บจริง) =====
# สมัครฟรีที่ upstash.com → สร้าง Redis database → คัดลอก REST URL และ REST TOKEN
# ถ้าไม่ใส่ จะเก็บในหน่วยความจำ (ใช้ได้แค่ทดสอบบนเครื่อง)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== จำกัดการใช้งาน (นับต่อวัน) =====
FREE_CHECKS_PER_IP_PER_DAY=5
FREE_CHECKS_PER_DAY=300
PDF_AI_READS_PER_IP_PER_DAY=10
ORDERS_PER_IP_PER_DAY=20

# ===== กันบอท Cloudflare Turnstile (ไม่บังคับ แต่แนะนำ) =====
# สมัครฟรีที่ dash.cloudflare.com → Turnstile → Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
